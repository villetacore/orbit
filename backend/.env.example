# Copy to backend/.env for `make api`. Values match docker-compose.yml and
# deploy/keycloak/orbit-realm.json; they are for local development only.
ORBIT_LISTEN_ADDR=:8080
ORBIT_PUBLIC_URL=http://localhost:5173
ORBIT_DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit?sslmode=disable
ORBIT_SESSION_SECRET=dev-only-session-secret-change-me-0123456789
ORBIT_SEED_DEMO=true
ORBIT_REGISTRATION_ENABLED=true

ORBIT_KEYCLOAK_URL=http://localhost:8081
ORBIT_KEYCLOAK_REALM=orbit
ORBIT_OIDC_CLIENT_ID=orbit-web
ORBIT_OIDC_CLIENT_SECRET=orbit-web-dev-secret
ORBIT_KEYCLOAK_ADMIN_CLIENT_ID=orbit-admin-api
ORBIT_KEYCLOAK_ADMIN_CLIENT_SECRET=orbit-admin-api-dev-secret
ORBIT_ADMIN_ROLE=orbit-admin

ORBIT_EDITABLE_ATTRIBUTES=phoneNumber,jobTitle
ORBIT_VISIBLE_ATTRIBUTES=department

ORBIT_STORAGE_DRIVER=fs
ORBIT_STORAGE_DIR=./data/avatars
# ORBIT_STORAGE_DRIVER=s3
# ORBIT_S3_ENDPOINT=localhost:9000
# ORBIT_S3_ACCESS_KEY=orbit
# ORBIT_S3_SECRET_KEY=orbit-minio-secret
# ORBIT_S3_BUCKET=orbit-avatars
